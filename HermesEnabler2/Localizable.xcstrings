    "Some options require matching display, sensor, or audio hardware." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Optionen erfordern passende Display-, Sensor- oder Audio-Hardware."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas opciones requieren una pantalla, un sensor o un hardware de audio coincidentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines options nécessitent un affichage, un capteur ou un matériel audio correspondant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のオプションでは、一致するディスプレイ、センサー、またはオーディオ ハードウェアが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 옵션에는 일치하는 디스플레이, 센서 또는 오디오 하드웨어가 필요합니다."
          }
