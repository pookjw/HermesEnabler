    "AOD 1Hz turned off. Restart Carousel to reload it. Faces must support seconds in AOD." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOD 1Hz ausgeschaltet. Starten Sie Carousel neu, um es neu zu laden. Zifferblätter müssen Sekunden in AOD unterstützen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOD 1Hz apagado. Reinicie Carousel para recargarlo. Las caras deben admitir segundos en AOD."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOD 1 Hz désactivé. Redémarrez Carousel pour le recharger. Les visages doivent prendre en charge les secondes dans AOD."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOD 1 Hzをオフにしました。Carouselを再起動してください。文字盤が常にオンでの秒表示に対応している必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOD 1Hz가 꺼졌습니다. Carousel을 다시 시작하세요. 시계 페이스가 화면 상시표시에서 초 단위 표시를 지원해야 합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOD 1Hz desligado. Reinicie Carousel para recarregá-lo. As faces devem suportar segundos em AOD."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭 AOD 1 Hz。请重新启动 Carousel；表盘须支持在全天候显示模式下显示秒数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已關閉 AOD 1 Hz。請重新啟動 Carousel；錶面須支援在永遠顯示模式下顯示秒數。"
          }
        }
      }
    },
