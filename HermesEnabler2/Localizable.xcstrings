    "class-2 fallback could not move Library — this build needs an app group on 27.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasse-2-Fallback konnte die Bibliothek nicht verschieben – dieser Build benötigt eine App-Gruppe auf 27.2"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El respaldo de clase 2 no pudo mover la biblioteca: esta compilación necesita un grupo de aplicaciones en 27.2"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solution de secours de classe 2 n'a pas pu déplacer la bibliothèque : cette version nécessite un groupe d'applications sur 27.2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラス 2 フォールバックはライブラリを移動できませんでした — このビルドには 27.2 のアプリ グループが必要です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클래스 2 대체 라이브러리를 이동할 수 없습니다. 이 빌드에는 27.2의 앱 그룹이 필요합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "o fallback class-2 não pôde mover a biblioteca – esta compilação precisa de um grupo de aplicativos em 27.2"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 级后备无法移动库 — 此版本需要 27.2 上的应用程序组"
          }
        },
        "zh-Hant" : {
