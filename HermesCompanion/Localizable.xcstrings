    "Pair your Apple Watch with this iPhone to use HermesEnabler.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HermesEnabler를 사용하려면 Apple Watch를 이 iPhone과 페어링하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch をこの iPhone とペアリングして、HermesEnabler を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将您的 Apple Watch 与此 iPhone 配对以使用 HermesEnabler。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將您的 Apple Watch 與此 iPhone 配對以使用 HermesEnabler。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln Sie Ihre Apple Watch mit diesem iPhone, um HermesEnabler zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareje su Apple Watch con este iPhone para usar HermesEnabler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez votre Apple Watch à cet iPhone pour utiliser HermesEnabler."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparelhe seu Apple Watch com este iPhone para usar o HermesEnabler."
          }
        }
      }
    },
    "HermesEnabler is installed on the iPhone, but the watch app is not installed.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에 HermesEnabler가 설치되어 있지만 시계 앱이 설치되어 있지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneにはHermesEnablerはインストールされていますが、Watchアプリはインストールされていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone上已安装HermesEnabler，但未安装手表应用程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone上已安裝HermesEnabler，但未安裝手錶應用程式。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HermesEnabler ist auf dem iPhone installiert, die Watch-App jedoch nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HermesEnabler está instalado en el iPhone, pero la aplicación del reloj no está instalada."
          }
        },
        "fr": {
