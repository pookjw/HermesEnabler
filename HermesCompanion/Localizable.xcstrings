{
  "sourceLanguage": "en",
  "strings": {
    "%@": {},
    "Backups will appear here.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 백업이 표시됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップがここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份将出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份將出現在這裡。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden Backups angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes apparaîtront ici."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups aparecerão aqui."
          }
        }
      }
    },
