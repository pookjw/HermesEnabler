    "Open the Watch app on your iPhone.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 Watch 앱을 엽니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone で Watch アプリを開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 iPhone 上的 Watch 应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 iPhone 上的 Watch 應用程式。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die Watch-App auf Ihrem iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la aplicación Watch en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l'application Watch sur votre iPhone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o aplicativo Watch no seu iPhone."
          }
        }
      }
    },
    "Find HermesEnabler in the list of apps.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 목록에서 HermesEnabler를 찾으세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのリストでHermesEnablerを見つけます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用程序列表中找到 HermesEnabler。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在應用程式列表中找到 HermesEnabler。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen Sie HermesEnabler in der Liste der Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque HermesEnabler en la lista de aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez HermesEnabler dans la liste des applications."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre HermesEnabler na lista de aplicativos."
          }
        }
      }
    },
    "Tap Install.": {
      "localizations": {
        "ko": {
          "stringUnit": {
